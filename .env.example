# Optional local overrides. Never commit actual secrets.
# Local host generates private keys in .runtime/ when these are absent.
DJANGO_SECRET_KEY=
SECOND_BRAIN_KEY=
# Optional server-side Sarvam voice and translation (restart after changes).
# scripts/start.sh does not source this file; export the variable or use .runtime/sarvam-key.
SARVAM_API_KEY=
# Real patient ingestion and live CARE import are not connected.
